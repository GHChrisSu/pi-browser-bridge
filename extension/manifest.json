{
  "manifest_version": 3,
  "name": "Pi Bridge",
  "version": "0.5.0",
  "description": "Chrome bridge for the Pi coding agent on this computer.",
  "homepage_url": "https://github.com/GHChrisSu/pi-browser-bridge",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "scripting",
    "tabs",
    "tabGroups",
    "storage",
    "downloads",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Pi Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
